# Copy to .env and fill in for the environment you're running in.
# Every value below has a working local/mock default baked into settings.py
# so the stack runs with no .env at all. Set GENIEBOT_ENV=production and the
# real_* values below to cut over to actual bank infrastructure.

GENIEBOT_ENV=local                     # local | uat | production

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://geniebot:geniebot@localhost:5432/geniebot

# --- Queue ----------------------------------------------------------------
QUEUE_BACKEND=memory                   # memory | sqs
SQS_QUEUE_URL=
SQS_DLQ_URL=

# --- Object storage (S3) --------------------------------------------------
STORAGE_BACKEND=local                  # local | s3
S3_BUCKET=genie-bot-logs
S3_WORKING_PREFIX=working/
LOCAL_S3_ROOT=./local_s3

# --- LLM / internal AI platform ------------------------------------------
LLM_BACKEND=mock                       # mock | internal_platform
INTERNAL_AI_PLATFORM_BASE_URL=https://internal-ai-platform.example.bank/v1
GENERATION_MODEL=gpt-5.1
EMBEDDING_MODEL=text-embedding-small

# --- Auth: OpenAM / DSP token translation ---------------------------------
AUTH_BACKEND=mock                      # mock | openam
OPENAM_TOKEN_URL=https://openam.example.bank/oauth2/token
DSP_TRANSLATE_URL=https://dsp.example.bank/token/translate
OPENAM_CLIENT_ID=
OPENAM_CLIENT_SECRET=
JWT_JWKS_URL=
JWT_AUDIENCE=geniebot-api
API_DEV_SHARED_SECRET=dev-only-shared-secret-change-me

# --- Jira -------------------------------------------------------------
JIRA_BACKEND=mock                      # mock | real
JIRA_BASE_URL=https://jira.example.bank
JIRA_PROJECT_KEY=GENIE
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# --- Mail -------------------------------------------------------------
MAIL_BACKEND=mock                      # mock | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
GENIE_SUPPORT_MAILBOX=genie-support@example.bank

# --- Secrets manager --------------------------------------------------
SECRETS_BACKEND=env                    # env | approved_secrets_manager
SECRETS_MANAGER_ENDPOINT=

# --- Vector store -------------------------------------------------------
VECTOR_STORE_BACKEND=pgvector           # pgvector | memory

# --- Guardrails / thresholds (overrides config/*.yaml; usually leave unset)
CONFIDENCE_THRESHOLD=
PER_INCIDENT_BUDGET_USD=
RERUN_LOOP_CAP=
