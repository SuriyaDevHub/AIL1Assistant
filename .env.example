# Copy to .env and fill in for the environment you're running in.
# Every value below has a working local/mock default baked into settings.py
# so the stack runs with no .env at all. Set GENIEBOT_ENV=production and the
# real_* values below to cut over to actual bank infrastructure.

GENIEBOT_ENV=local                     # local | uat | production

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://geniebot:geniebot@localhost:5432/geniebot

# --- Queue ----------------------------------------------------------------
QUEUE_BACKEND=memory                   # memory | sqs
SQS_QUEUE_URL=
SQS_DLQ_URL=

# --- Object storage (S3) --------------------------------------------------
STORAGE_BACKEND=local                  # local | s3
S3_BUCKET=genie-bot-logs
S3_WORKING_PREFIX=working/
LOCAL_S3_ROOT=./local_s3

# --- LLM / internal AI platform ------------------------------------------
# Switch providers/models by changing LLM_BACKEND (+ that backend's own
# section below) and GENERATION_MODEL - no code change needed either way.
LLM_BACKEND=mock                       # mock | internal_platform | openai | anthropic

# internal_platform: your own AI platform, reached at its own FQDN, speaking
# an OpenAI-compatible chat/completions + embeddings wire format
# (llm/internal_platform_client.py). Authenticates via OpenAM/DSP token
# translation (OPENAM_*/DSP_* below) - independent of AUTH_BACKEND, which is
# the separate, unrelated setting for how the review UI's own end users log
# in. INTERNAL_AI_PLATFORM_CA_BUNDLE is only needed if your platform's FQDN
# presents a cert signed by an internal CA not in the system trust store
# (common on a restricted/internal network) - leave empty to use the
# default trust store.
INTERNAL_AI_PLATFORM_BASE_URL=https://internal-ai-platform.example.bank/v1
INTERNAL_AI_PLATFORM_CA_BUNDLE=
# openai: a real, publicly-reachable OpenAI-compatible backend (OpenAI
# itself, Azure OpenAI, self-hosted) authenticated with a plain API key -
# see llm/auth.py's StaticTokenProvider. Distinct from internal_platform
# above, which targets your own platform behind OpenAM/DSP.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# anthropic: the real Anthropic Messages API - different wire format from
# the OpenAI-compatible client above, so it has its own client class
# (llm/anthropic_client.py). No embeddings endpoint, so KB retrieval still
# uses the local deterministic embedding even with LLM_BACKEND=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# GENERATION_MODEL: leave empty to let each agent use the model pinned in
# its own prompt config (config/prompts/*.yaml `model:` field - a prompt is
# often tuned against one specific model's response style). Set this to
# override every agent to one model in one place instead - e.g. whatever
# model name your internal platform serves - without hand-editing all
# three prompt files (agents/base.py).
GENERATION_MODEL=
# EMBEDDING_MODEL is only actually used with LLM_BACKEND=openai or
# internal_platform (kb/build_pipeline.py, kb/retrieval.py read
# settings.embedding_model directly) - text-embedding-3-small is OpenAI's
# small embedding model; use whatever your internal platform calls its
# embedding model if using internal_platform. Ignored under
# LLM_BACKEND=anthropic (no embeddings API - see llm/local_embeddings.py).
EMBEDDING_MODEL=text-embedding-3-small

# --- Auth ------------------------------------------------------------
# AUTH_BACKEND + JWT_JWKS_URL/JWT_AUDIENCE: validating INCOMING tokens from
# the review UI's own end users (api/deps.py) - who's allowed to call this
# API. OPENAM_TOKEN_URL/DSP_TRANSLATE_URL/OPENAM_CLIENT_ID/OPENAM_CLIENT_SECRET
# below are a separate concern: fetching an OUTGOING token this app presents
# to call other systems with (the internal AI platform above, when
# configured; llm/auth.py's OpenAMDSPTokenProvider). The two are
# independent - set one, both, or neither depending on what's actually
# behind OpenAM in your environment.
AUTH_BACKEND=mock                      # mock | openam
JWT_JWKS_URL=
JWT_AUDIENCE=geniebot-api
OPENAM_TOKEN_URL=https://openam.example.bank/oauth2/token
DSP_TRANSLATE_URL=https://dsp.example.bank/token/translate
OPENAM_CLIENT_ID=
OPENAM_CLIENT_SECRET=
API_DEV_SHARED_SECRET=dev-only-shared-secret-change-me

# --- Jira -------------------------------------------------------------
JIRA_BACKEND=mock                      # mock | real
JIRA_BASE_URL=https://jira.example.bank
JIRA_PROJECT_KEY=GENIE
JIRA_API_TOKEN=
JIRA_USER_EMAIL=

# --- Mail -------------------------------------------------------------
MAIL_BACKEND=mock                      # mock | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
GENIE_SUPPORT_MAILBOX=genie-support@example.bank

# --- Secrets manager --------------------------------------------------
SECRETS_BACKEND=env                    # env | approved_secrets_manager
SECRETS_MANAGER_ENDPOINT=

# --- Vector store -------------------------------------------------------
VECTOR_STORE_BACKEND=pgvector           # pgvector | memory

# --- Guardrails / thresholds (overrides config/*.yaml; usually leave unset)
CONFIDENCE_THRESHOLD=
PER_INCIDENT_BUDGET_USD=
RERUN_LOOP_CAP=
